# Copy to .env for local development. Never commit real values.
DATABASE_URL=postgres://coach:coach@localhost:5432/training_coach
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
SMTP_URL=smtp://localhost:1025
API_PORT=4000
# Public URL the browser uses (web + /api on the same origin)
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_TELEMETRY=0
# Optional: comma-separated emails allowed to sign up (recommended for a private instance)
SIGNUP_ALLOWED_EMAILS=
